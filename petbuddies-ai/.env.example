GEMINI_API_KEY=
# Banco local do docker-compose.
MYSQL_URL=jdbc:mysql://localhost:3306/petbuddies_cuidado
MYSQL_USER=petbuddies_cuidado
MYSQL_PASSWORD=petbuddies
# Senha do root do container; so o compose usa.
MYSQL_ROOT_PASSWORD=mysql

# Segredo do JWT (ADR s3-20) — HS256, minimo 32 bytes.
# O MESMO valor byte a byte no .NET; nunca versionado.
PETBUDDIES_JWT_SECRET=
# Porta do MySQL no host. Duas worktrees ao mesmo tempo precisam de portas
# diferentes; use tambem COMPOSE_PROJECT_NAME proprio em cada uma.
MYSQL_PORT=3306
