# cp .env.example .env e preencha. O .env não vai para o Git.
#
# As senhas devem ser SÓ alfanuméricas, começando por letra. Elas atravessam a
# connection string do .NET (onde ';' e '=' são separadores) e a expansão de
# shell no az container create — um caractere especial quebra em um desses
# dois e o sintoma aparece longe da causa.

MYSQL_ROOT_PASSWORD=
MYSQL_USER_CUIDADO=petbuddies_cuidado
MYSQL_PASSWORD_CUIDADO=

# HS256, mínimo 32 caracteres. O MESMO valor nos dois serviços (ADR s3-20):
# o Java emite o token e o .NET o valida.
PETBUDDIES_JWT_SECRET=

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
