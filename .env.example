# cp .env.example .env e preencha. O .env não vai para o Git.
#
# As senhas devem ser SÓ alfanuméricas, começando por letra. Elas atravessam a
# regra de senha do Oracle, a connection string do .NET (onde ';' e '=' são
# separadores) e a expansão de shell no az container create — um caractere
# especial quebra em um desses três e o sintoma aparece longe da causa.

ORACLE_SYS_PASSWORD=
ORACLE_USER_CUIDADO=PETBUDDIES_CUIDADO
ORACLE_PASSWORD_CUIDADO=

# HS256, mínimo 32 caracteres. O MESMO valor nos dois serviços (ADR s3-20):
# o Java emite o token e o .NET o valida.
PETBUDDIES_JWT_SECRET=

# https://aistudio.google.com/apikey
GEMINI_API_KEY=
